{
  "name": "@lapis-lang/lang-forma",
  "version": "1.2.1",
  "exports": "./src/index.ts",
  "license": "MPL-2.0",
  "publish": {
    "include": [
      "LICENSE",
      "README.md",
      "src/**/*.ts",
      "docs/diagrams/**/*.svg"
    ]
  },
  "tasks": {
    "test": "deno test",
    "example": "deno run examples/arith-demo.ts",
    "bench": "deno run examples/scaling-bench.ts",
    "check-docs": "deno run --allow-read --allow-run=deno scripts/check_docs.ts"
  },
  "lint": {
    "include": [
      "src/",
      "test/",
      "examples/"
    ]
  },
  "fmt": {
    "include": [
      "src/",
      "test/",
      "examples/"
    ]
  },
  "compilerOptions": {
    "strict": true
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.19"
  }
}